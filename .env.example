# ─────────────────────────────────────────────────────────────────────────────
# WagerX Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local to version control.

# ── App Configuration ─────────────────────────────────────────────────────────
APP_NAME=WagerX
APP_DESCRIPTION="Experience thrilling bets and massive wins with WagerX, the premier online betting platform."
APP_TITLE="WagerX - Wager Up! Wager Win!"
APP_OG_IMAGE=/images/og-image.jpg
APP_FAVICON=/favicon.ico
APP_URL=http://localhost:3000
APP_COUNTRY=Nigeria
APP_COUNTRY_CODE=234
APP_CURRENCY=NGN
APP_CURRENCY_SYMBOL=₦
APP_MAINTENANCE=false
APP_TIMEZONE=Africa/Lagos
APP_PRIMARY_COLOR=#6366f1

# ── MySQL Database ─────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=wagerx

# ── NextAuth.js ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32  (or any secure random string)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-secure-random-string-here

# ── JWT (Email Verification & Password Reset) ──────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-64-char-hex-string-here

# ── Paystack (Payment Gateway) ───────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_TEST_MODE=true
NEXT_PUBLIC_PAYSTACK_ENABLE=true

# ── Flutterwave (Optional secondary gateway) ──────────────────────────────────
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
NEXT_PUBLIC_FLUTTERWAVE_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_TEST_MODE=true
NEXT_PUBLIC_FLUTTERWAVE_ENABLE=false

# ── SMTP (Email via Nodemailer) ───────────────────────────────────────────────
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=example.com

# ── EmailJS (Client-side email templates) ─────────────────────────────────────
EMAILJS_SERVICE_ID=service_xxxxxxxxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxxxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── reCAPTCHA (Optional) ───────────────────────────────────────────────────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Withdrawal / Deposit Limits ───────────────────────────────────────────────
NEXT_PUBLIC_WITHDRAWAL_CHARGE=0.5
NEXT_PUBLIC_MIN_WITHDRAWAL_AMOUNT=2000
WITHDRAWAL_CHARGE=0.5
APP_USER_REF_BONUS=100
APP_TAKE_AMOUNT=15
MIN_WITHDRAWAL_AMOUNT=5000
MAX_WITHDRAWAL_AMOUNT=1000000
MIN_DEPOSIT=500
MAX_DEPOSIT=1000000

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_REFERRALS=TRUE
ENABLE_BONUSES=TRUE

# ── API Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ── Firebase (Legacy — game session realtime, being phased out) ──────────────
# Only needed if using real-time game sessions. Can be left empty if not.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-side, only if realtime is enabled)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Firebase service account (alternative format)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
